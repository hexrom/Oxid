# GitLab OAuth (register at GitLab > Settings > Applications)
# Redirect URI must be set to: {APP_URL}/api/auth/gitlab/callback
# Scopes: read_user read_api read_repository
GITLAB_APP_ID=your_app_id
GITLAB_APP_SECRET=your_app_secret
GITLAB_INSTANCE_URL=https://gitlab.com

# App
APP_URL=http://localhost:3000

# Database (SQLite by default; swap to Postgres later if needed)
DATABASE_URL="file:./dev.db"

# Oxid CLI binary. Must be on PATH or provide an absolute path.
OXID_BIN=oxid

# Optional: scan timeout in milliseconds (default 300000 = 5min)
SCAN_TIMEOUT_MS=300000
