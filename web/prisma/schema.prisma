datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model GitlabConnection {
  id             String   @id @default(cuid())
  accessToken    String
  refreshToken   String?
  tokenExpiresAt DateTime?
  gitlabUserId   String   @unique
  gitlabUsername String
  instanceUrl    String   @default("https://gitlab.com")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Project {
  id                String   @id @default(cuid())
  gitlabProjectId   Int      @unique
  name              String
  nameWithNamespace String
  defaultBranch     String   @default("main")
  httpUrlToRepo     String
  webUrl            String
  language          String   @default("Rust")
  importedAt        DateTime @default(now())
  scans             Scan[]
}

model Scan {
  id           String    @id @default(cuid())
  projectId    String
  project      Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status       String    @default("pending") // pending | running | completed | failed
  branch       String
  commitSha    String?
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  duration     Int? // milliseconds
  summary      String? // JSON: { critical, high, medium, low, info, total, scanners: string[] }
  errorMessage String?
  findings     Finding[]

  @@index([projectId, startedAt])
}

model Finding {
  id             String  @id @default(cuid())
  scanId         String
  scan           Scan    @relation(fields: [scanId], references: [id], onDelete: Cascade)
  findingId      String // e.g. "RUSTSEC-2020-0159"
  title          String
  description    String?
  severity       String // critical | high | medium | low | info
  kind           String // sca | sast | license | unsafe
  packageName    String?
  packageVersion String?
  filePath       String?
  line           Int?
  column         Int?
  remediation    String?
  references     String? // JSON array of URLs
  sourceScanners String // JSON array of scanner names

  @@index([scanId, severity])
}
